# LLM_Model3 environment variables - template.
# Copy to .env and fill in real values. .env is gitignored. Never commit real keys.
# Secrets are read from the environment only, never from tracked config files.

# --- Market data ---
# Polygon: ETF daily history (split/dividend-adjusted). Confirm the key is provisioned for LLM_Model3 on Godzilla.
POLYGON_API_KEY=

# --- LLM (Engine B feature-extractor layer only; never the predictor) ---
# Used in P4 to compute the LLM feature group whose marginal IC is measured against the mechanical baseline.
ANTHROPIC_API_KEY=

# --- Optional: broker (paper only; not used until P5 paper-trading) ---
# Real money is prohibited until an engine clears the kill rule AND survives paper.
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
